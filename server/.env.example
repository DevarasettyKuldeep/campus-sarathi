# Copy to .env locally. Never paste real credentials into chat or commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Configure this after installing PostgreSQL and creating the development DB.
# DATABASE_URL=postgresql://campus_sarathi:LOCAL_PASSWORD@localhost:5432/campus_sarathi
# Integration tests require a separate, migrated database. They skip if absent.
# TEST_DATABASE_URL=postgresql://campus_sarathi:LOCAL_PASSWORD@localhost:5432/campus_sarathi_test
# Gemini configuration will be introduced with the AI module.
# Enable server sign-in only after all three are configured (DB URL above plus
# Google's Web client IDs and a cryptographically generated server signing key).
# GOOGLE_CLIENT_IDS=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Generate a random 32-byte base64url signing key; do not use a sample key.
# AUTH_SIGNING_KEY=
# A Google OAuth client secret is not used for this ID-token verification flow.
