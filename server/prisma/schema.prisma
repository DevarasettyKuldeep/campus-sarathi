generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  googleSubject   String           @unique @map("google_subject") @db.VarChar(255)
  email           String           @unique @db.VarChar(320)
  displayName     String           @map("display_name") @db.VarChar(200)
  emailVerifiedAt DateTime         @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile         AcademicProfile?
  sessions        Session[]
  consentRecords  ConsentRecord[]
  profileSyncReceipts ProfileSyncReceipt[]
  subjects            Subject[]
  courses             Course[]
  classes             ClassSchedule[]
  attendance          AttendanceRecord[]
  assignments         AssignmentRecord[]
  academicSyncReceipts AcademicSyncReceipt[]

  @@map("users")
}

model AcademicProfile {
  userId         String   @id @map("user_id") @db.Uuid
  programme      String   @db.VarChar(200)
  semesterNumber Int      @map("semester_number")
  semesterStart  DateTime @map("semester_start") @db.Date
  semesterEnd    DateTime @map("semester_end") @db.Date
  timezone       String   @default("Asia/Kolkata") @db.VarChar(64)
  revision       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("academic_profiles")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  refreshHash Bytes     @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ConsentPurpose {
  ACADEMIC_PROCESSING
  GEMINI_PROCESSING
}

model ConsentRecord {
  id            String         @id @default(uuid()) @db.Uuid
  sequence      BigInt         @unique @default(autoincrement())
  userId        String         @map("user_id") @db.Uuid
  purpose       ConsentPurpose
  noticeVersion String         @map("notice_version") @db.VarChar(100)
  granted       Boolean
  eventAt       DateTime       @default(now()) @map("event_at") @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, sequence])
  @@map("consent_records")
}

model ProfileSyncReceipt {
  userId String @map("user_id") @db.Uuid
  operationId String @map("operation_id") @db.Uuid
  payloadHash Bytes @map("payload_hash")
  result Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, operationId])
  @@map("profile_sync_receipts")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  revision  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   Course[]

  @@unique([userId, code])
  @@unique([userId, id])
  @@map("subjects")
}

model Course {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  subjectId           String             @map("subject_id") @db.Uuid
  semesterLabel       String             @map("semester_label") @db.VarChar(50)
  credits             Int?
  attendanceThreshold Decimal?           @map("attendance_threshold") @db.Decimal(5, 2)
  revision            Int                @default(1)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject             Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classes             ClassSchedule[]
  assignments         AssignmentRecord[]

  @@unique([userId, subjectId, semesterLabel])
  @@unique([userId, id])
  @@map("courses")
}

model ClassSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  courseId    String?  @map("course_id") @db.Uuid
  subjectName String   @map("subject_name") @db.VarChar(200)
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt
  room        String   @db.VarChar(200)
  source      String   @default("student") @db.VarChar(50)
  revision    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, weekday])
  @@map("class_schedules")
}

model AttendanceRecord {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  courseId          String?  @map("course_id") @db.Uuid
  subjectKey        String   @map("subject_key") @db.VarChar(200)
  subjectName       String   @map("subject_name") @db.VarChar(200)
  attended          Int
  conducted         Int
  minimumPercentage Decimal? @map("minimum_percentage") @db.Decimal(5, 2)
  source            String   @default("student") @db.VarChar(50)
  revision          Int      @default(1)
  observedAt        DateTime @default(now()) @map("observed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectKey, source])
  @@map("attendance_records")
}

model AssignmentRecord {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  courseId         String?  @map("course_id") @db.Uuid
  subjectName      String   @map("subject_name") @db.VarChar(200)
  title            String   @db.VarChar(200)
  notes            String?  @db.Text
  dueAt            DateTime @map("due_at") @db.Timestamptz(3)
  completed        Boolean  @default(false)
  estimatedMinutes Int?     @map("estimated_minutes")
  importance       String   @default("medium") @db.VarChar(20)
  source           String   @default("student") @db.VarChar(50)
  revision         Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, completed, dueAt])
  @@map("assignment_records")
}

model AnnouncementRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @default("public") @db.VarChar(50)
  title       String   @db.VarChar(250)
  body        String   @db.Text
  originUrl   String?  @map("origin_url") @db.VarChar(500)
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@index([scope, publishedAt])
  @@map("announcement_records")
}

model AcademicSyncReceipt {
  userId      String   @map("user_id") @db.Uuid
  operationId String   @map("operation_id") @db.Uuid
  payloadHash Bytes    @map("payload_hash")
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, operationId])
  @@map("academic_sync_receipts")
}

